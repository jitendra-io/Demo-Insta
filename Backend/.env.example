# Backend Environment Configuration
PORT=3000

# MongoDB Connection String (e.g., MongoDB Atlas or local MongoDB instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority

# ImageKit Private API Key (obtain from ImageKit developer console)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
